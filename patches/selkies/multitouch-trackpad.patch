diff --git a/crates/selkies/src/input/multitouch.rs b/crates/selkies/src/input/multitouch.rs
new file mode 100644
index 0000000..d717ad7
--- /dev/null
+++ b/crates/selkies/src/input/multitouch.rs
@@ -0,0 +1,246 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+
+//! One kernel multitouch trackpad for a Selkies session with a device-consuming X11 seat.
+//! A full contact snapshot is scoped to a single connection. An empty snapshot or
+//! a disconnected owner lifts every contact in one Linux input frame.
+
+use crate::gamepad::ConnId;
+use crate::gamepad::abi::{
+    AbsInfo, EV_ABS, EV_KEY, UI_ABS_SETUP, UI_DEV_CREATE, UI_DEV_SETUP, UI_SET_ABSBIT,
+    UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_PROPBIT, UINPUT_PATH, pack_evdev_frame,
+    pack_uinput_abs_setup, pack_uinput_setup,
+};
+use crate::gamepad::uinput::{ioctl_buf, ioctl_int};
+use std::{
+    fs::{File, OpenOptions},
+    io::{self, Write},
+    os::fd::AsRawFd,
+};
+
+const SLOTS: usize = 10;
+const MAX_POSITION: u16 = 32767;
+const ABS_X: u16 = 0;
+const ABS_Y: u16 = 1;
+const ABS_MT_SLOT: u16 = 0x2f;
+const ABS_MT_POSITION_X: u16 = 0x35;
+const ABS_MT_POSITION_Y: u16 = 0x36;
+const ABS_MT_TRACKING_ID: u16 = 0x39;
+const BTN_TOUCH: u16 = 0x14a;
+const BTN_LEFT: u16 = 0x110;
+const TOOL_KEYS: [u16; 5] = [0x145, 0x14d, 0x14e, 0x14f, 0x148];
+
+/// A contact's stable ID and normalized x and y, with the origin at the top left.
+#[derive(Clone, Copy, serde::Deserialize)]
+struct Contact(u16, u16, u16);
+
+type Event = (u16, u16, i32);
+type Slots = [Option<Contact>; SLOTS];
+
+/// The device and the client whose snapshot currently fills its slots.
+pub(crate) struct Trackpad {
+    fd: File,
+    owner: Option<ConnId>,
+    slots: Slots,
+}
+
+impl Trackpad {
+    /// Create the device only for an operator-enabled X11 seat that consumes kernel input.
+    pub(crate) fn configured(is_wayland: bool) -> Option<Self> {
+        if is_wayland || std::env::var("SELKIES_MULTITOUCH_TRACKPAD").as_deref() != Ok("true") {
+            return None;
+        }
+        match Self::open() {
+            Ok(device) => Some(device),
+            Err(error) => {
+                log::warn!(target: "input", "Multitouch trackpad unavailable: {error}");
+                None
+            }
+        }
+    }
+
+    fn open() -> io::Result<Self> {
+        let fd = OpenOptions::new().write(true).open(UINPUT_PATH)?;
+        let raw = fd.as_raw_fd();
+        ioctl_int(raw, UI_SET_EVBIT, i64::from(EV_ABS))?;
+        ioctl_int(raw, UI_SET_EVBIT, i64::from(EV_KEY))?;
+        ioctl_int(raw, UI_SET_PROPBIT, 0)?; // INPUT_PROP_POINTER identifies an indirect device.
+        for key in [BTN_TOUCH, BTN_LEFT].into_iter().chain(TOOL_KEYS) {
+            ioctl_int(raw, UI_SET_KEYBIT, i64::from(key))?;
+        }
+        for (axis, max, resolution) in [
+            (ABS_X, i32::from(MAX_POSITION), 250),
+            (ABS_Y, i32::from(MAX_POSITION), 410),
+            (ABS_MT_POSITION_X, i32::from(MAX_POSITION), 250),
+            (ABS_MT_POSITION_Y, i32::from(MAX_POSITION), 410),
+            (ABS_MT_SLOT, 9, 0),
+            (ABS_MT_TRACKING_ID, i32::from(u16::MAX), 0),
+        ] {
+            ioctl_int(raw, UI_SET_ABSBIT, i64::from(axis))?;
+            ioctl_buf(
+                raw,
+                UI_ABS_SETUP,
+                &mut pack_uinput_abs_setup(
+                    axis,
+                    AbsInfo {
+                        minimum: 0,
+                        maximum: max,
+                        fuzz: 0,
+                        flat: 0,
+                        resolution,
+                    },
+                ),
+            )?;
+        }
+        ioctl_buf(
+            raw,
+            UI_DEV_SETUP,
+            &mut pack_uinput_setup(3, 0, 0, 1, "Selkies Multitouch Trackpad", 0),
+        )?;
+        ioctl_int(raw, UI_DEV_CREATE, 0)?;
+        Ok(Self {
+            fd,
+            owner: None,
+            slots: [None; SLOTS],
+        })
+    }
+
+    /// Validate a frame and replace the active contacts belonging to its owner.
+    pub(crate) fn apply(&mut self, conn: ConnId, json: &str) -> io::Result<()> {
+        if self.owner.is_some_and(|owner| owner != conn) {
+            return Ok(());
+        }
+        let Some(contacts) = contacts(json) else {
+            return Ok(());
+        };
+        if self.owner.is_none() && contacts.is_empty() {
+            return Ok(());
+        }
+        self.write(&contacts)?;
+        self.owner = (!contacts.is_empty()).then_some(conn);
+        Ok(())
+    }
+
+    /// Lift the owner's contacts without affecting gestures on another connection.
+    pub(crate) fn release(&mut self, conn: ConnId) -> io::Result<()> {
+        if self.owner == Some(conn) {
+            self.write(&[])?;
+            self.owner = None;
+        }
+        Ok(())
+    }
+
+    fn write(&mut self, contacts: &[Contact]) -> io::Result<()> {
+        let (slots, events) = frame(self.slots, contacts);
+        let arch = if usize::BITS == 64 { 64 } else { 32 };
+        self.fd.write_all(&pack_evdev_frame(&events, arch))?;
+        self.slots = slots;
+        Ok(())
+    }
+}
+
+fn contacts(json: &str) -> Option<Vec<Contact>> {
+    if json.len() > 1024 {
+        return None;
+    }
+    let contacts: Vec<Contact> = serde_json::from_str(json).ok()?;
+    if contacts.len() > SLOTS
+        || contacts
+            .iter()
+            .enumerate()
+            .any(|(index, &Contact(id, x, y))| {
+                id == 0
+                    || x > MAX_POSITION
+                    || y > MAX_POSITION
+                    || contacts[..index].iter().any(|c| c.0 == id)
+            })
+    {
+        return None;
+    }
+    Some(contacts)
+}
+
+/// Generate a type-B `SYN_REPORT` payload with persistent slots for contacts that remain down.
+fn frame(mut slots: Slots, contacts: &[Contact]) -> (Slots, Vec<Event>) {
+    let mut events = vec![(EV_KEY, BTN_TOUCH, i32::from(!contacts.is_empty()))];
+    for (index, slot) in slots.iter_mut().enumerate() {
+        if slot.is_some_and(|old| !contacts.iter().any(|contact| contact.0 == old.0)) {
+            events.push((EV_ABS, ABS_MT_SLOT, index as i32));
+            events.push((EV_ABS, ABS_MT_TRACKING_ID, -1));
+            *slot = None;
+        }
+    }
+    for &contact in contacts {
+        let existing = slots
+            .iter()
+            .position(|slot| slot.is_some_and(|old| old.0 == contact.0));
+        let Some(index) = existing.or_else(|| slots.iter().position(Option::is_none)) else {
+            break;
+        };
+        events.push((EV_ABS, ABS_MT_SLOT, index as i32));
+        if existing.is_none() {
+            events.push((EV_ABS, ABS_MT_TRACKING_ID, i32::from(contact.0)));
+        }
+        events.push((EV_ABS, ABS_MT_POSITION_X, i32::from(contact.1)));
+        events.push((EV_ABS, ABS_MT_POSITION_Y, i32::from(contact.2)));
+        slots[index] = Some(contact);
+    }
+    if let Some(contact) = slots.iter().flatten().next() {
+        events.push((EV_ABS, ABS_X, i32::from(contact.1)));
+        events.push((EV_ABS, ABS_Y, i32::from(contact.2)));
+    }
+    let tool_count = contacts.len().min(TOOL_KEYS.len());
+    for (index, key) in TOOL_KEYS.into_iter().enumerate() {
+        events.push((EV_KEY, key, i32::from(index + 1 == tool_count)));
+    }
+    (slots, events)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn validates_bounds_ids_and_duplicate_contacts() {
+        assert!(contacts("[[1,0,32767],[2,1,2]]").is_some());
+        assert!(contacts("[[0,0,1]]").is_none());
+        assert!(contacts("[[1,0,32768]]").is_none());
+        assert!(contacts("[[1,0,0],[1,1,1]]").is_none());
+    }
+
+    #[test]
+    fn a_second_connection_cannot_move_or_lift_the_owners_contacts() {
+        let mut device = Trackpad {
+            fd: tempfile::tempfile().unwrap(),
+            owner: None,
+            slots: [None; SLOTS],
+        };
+        device.apply(10, "[[1,12,34]]").unwrap();
+        assert_eq!(device.owner, Some(10));
+        device.apply(11, "[[2,2,4]]").unwrap();
+        device.apply(11, "[]").unwrap();
+        device.release(11).unwrap();
+        assert_eq!(device.slots[0].unwrap().0, 1);
+        device.release(10).unwrap();
+        assert!(device.slots.iter().all(Option::is_none));
+        device.apply(11, "[[2,2,4]]").unwrap();
+        assert_eq!(device.owner, Some(11));
+    }
+
+    #[test]
+    fn publishes_stable_slots_and_lifts_removed_contacts() {
+        let (slots, start) = frame([None; SLOTS], &[Contact(1, 32, 64), Contact(2, 5, 6)]);
+        assert!(start.contains(&(EV_KEY, TOOL_KEYS[1], 1)));
+        let (slots, move_one) = frame(slots, &[Contact(2, 6, 7)]);
+        assert!(slots[0].is_none());
+        assert_eq!(slots[1].unwrap().0, 2);
+        assert!(move_one.contains(&(EV_ABS, ABS_MT_TRACKING_ID, -1)));
+        assert!(!move_one.contains(&(EV_ABS, ABS_MT_TRACKING_ID, 2)));
+        let (slots, ended) = frame(slots, &[]);
+        assert!(slots.iter().all(Option::is_none));
+        assert_eq!(ended[0], (EV_KEY, BTN_TOUCH, 0));
+    }
+}
